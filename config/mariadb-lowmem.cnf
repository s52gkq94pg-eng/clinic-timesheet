# Tuned for a GCP e2-micro instance (1 GB total RAM, shared with the OS,
# Docker, Apache/PHP, and Caddy). Defaults would let MariaDB claim well
# over 1 GB by itself and get OOM-killed. Keep total InnoDB + connection
# overhead well under ~300 MB.
#
# If you ever move to a bigger instance, raise innodb_buffer_pool_size
# first -- it's the setting with the biggest effect on performance.

[mysqld]
innodb_buffer_pool_size = 128M
innodb_buffer_pool_instances = 1
innodb_log_file_size = 32M
innodb_flush_log_at_trx_commit = 2

key_buffer_size = 8M
max_connections = 30
table_open_cache = 64
tmp_table_size = 16M
max_heap_table_size = 16M
thread_cache_size = 4

performance_schema = OFF
query_cache_type = 0
query_cache_size = 0
