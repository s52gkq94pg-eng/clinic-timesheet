# Copy this file to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored -- never commit real secrets.

# Domain that DNS-resolves (A record) to this server's static IP.
# Required: Caddy needs a real domain to get a Let's Encrypt certificate,
# it cannot issue a trusted cert for a bare IP address.
DOMAIN=timesheet.yourclinic.com

# Kimai's bootstrap admin account (created on first start).
# Log in and change the password immediately, then treat these as unused.
ADMIN_EMAIL=admin@yourclinic.com
ADMIN_PASSWORD=change-me-immediately

# Symfony app secret. Generate with:  openssl rand -hex 32
APP_SECRET=replace-with-a-long-random-string

# Database credentials. Generate strong random values, e.g.:  openssl rand -base64 24
DB_NAME=kimai
DB_USER=kimaiuser
DB_PASSWORD=replace-me
DB_ROOT_PASSWORD=replace-me-too
